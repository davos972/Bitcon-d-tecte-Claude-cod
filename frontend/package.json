{
  "name": "btc-markov-frontend",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-constants": "~17.0.0",
    "react": "18.2.0",
    "react-native": "0.76.2",
    "react-native-safe-area-context": "4.12.0",
    "@react-native-async-storage/async-storage": "2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.0",
    "babel-preset-expo": "~13.0.0",
    "jest": "^29.7.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
