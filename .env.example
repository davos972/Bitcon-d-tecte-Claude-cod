# Backend environment variables
# Copy this file to .env and fill in the values

# Optional but vital in production (shared IPs get rate-limited fast)
CRYPTOCOMPARE_API_KEY=

# MongoDB (optional — if you want server-side prediction persistence)
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=btc_markov

# Frontend environment variables (prefix EXPO_PUBLIC_ to expose to the app)
# NEVER use localhost in production — use your deployed backend URL
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
